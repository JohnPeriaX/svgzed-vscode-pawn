[
  {
    "label": "GtaClassic: Build only (sampctl)",
    "command": "sampctl",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "save": "all"
  },
  {
    "label": "GtaClassic: Build watcher (sampctl)",
    "command": "sampctl",
    "args": ["build", "--watch"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "save": "all"
  },
  {
    "label": "GtaClassic: Run tests (sampctl)",
    "command": "sampctl",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "save": "all"
  },
  {
    "label": "GtaClassic: Run tests watcher (sampctl)",
    "command": "sampctl",
    "args": ["run", "--watch"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "save": "all"
  }
]
