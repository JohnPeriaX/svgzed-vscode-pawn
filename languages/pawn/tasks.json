[
  {
    "label": "Pawn: Build",
    "command": "pwsh",
    "args": [
      "-NoProfile",
      "-File",
      "$ZED_WORKTREE_ROOT\\scripts\\pawn-build.ps1",
      "-WorkspaceRoot",
      "$ZED_WORKTREE_ROOT",
      "-SourceFile",
      "$ZED_FILE",
      "-Mode",
      "auto"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Pawn: Build with pawncc",
    "command": "pwsh",
    "args": [
      "-NoProfile",
      "-File",
      "$ZED_WORKTREE_ROOT\\scripts\\pawn-build.ps1",
      "-WorkspaceRoot",
      "$ZED_WORKTREE_ROOT",
      "-SourceFile",
      "$ZED_FILE",
      "-Mode",
      "pawno"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]
