[
  {
    "label": "Pawn: Build",
    "command": "sampctl",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Pawn: Build with pawncc",
    "command": "pawncc",
    "args": ["$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]
