[
  {
    "label": "Pawn: Build sampctl",
    "command": "sampctl",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "save": "all"
  },
  {
    "label": "Pawn: Ensure sampctl",
    "command": "sampctl",
    "args": ["ensure"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "save": "all"
  }
]
